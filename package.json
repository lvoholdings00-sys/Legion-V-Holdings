{
  "name": "lvo-cloud",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create lvo-cloud-db",
    "db:migrate": "wrangler d1 execute lvo-cloud-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute lvo-cloud-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute lvo-cloud-db --remote --file=./seed.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
